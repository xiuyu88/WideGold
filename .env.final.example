# =============================================================================
# WideGold V1 Final - Windows / Docker 生产环境模板
# 复制为 .env 后填写必要值；严禁把 .env 提交到 Git。
# =============================================================================

WIDEGOLD_ENV=production
WIDEGOLD_PERSISTENCE=postgres
WIDEGOLD_RUNTIME_CONFIG_SOURCE=db
WIDEGOLD_RUNTIME_CONFIG_CACHE_TTL_SECONDS=5
WIDEGOLD_RUNTIME_CONFIG_GENERATION_POLL_SECONDS=1
WIDEGOLD_ORCHESTRATION_MODE=prefect

# 真实数据模式
WIDEGOLD_DATA_MODE=raw_indicators
WIDEGOLD_FACTOR_FEED_URL=
# FRED 美国宏观/市场指标需要此 Key
FRED_API_KEY=

# 统一免费 External Bridge：一个本地 sidecar，5 个 capability
WIDEGOLD_EXTERNAL_INDICATOR_URL=http://external-bridge:9100
# 内部服务认证密钥，不是付费 Vendor Token；建议本地随机生成。
WIDEGOLD_EXTERNAL_INDICATOR_API_KEY=
EXTERNAL_BRIDGE_PORT=9100
WIDEGOLD_EXTERNAL_BRIDGE_RETRY_ATTEMPTS=2
WIDEGOLD_EXTERNAL_BRIDGE_RETRY_DELAY_SECONDS=0.4
WIDEGOLD_EXTERNAL_BRIDGE_HTTP_TIMEOUT_SECONDS=20
WIDEGOLD_EARNINGS_REV_WINDOW_DAYS=7
WIDEGOLD_EARNINGS_REV_MIN_COVERAGE=0.50
# 可选：固定 WGC GDT 公共工作簿地址；留空则自动发现。
WIDEGOLD_WGC_XLSX_URL=

# 可选：机器 PUSH 接口认证密钥
WIDEGOLD_INGEST_API_KEY=

# 新闻 / 事件智能
WIDEGOLD_EVENT_GRAPH_MODE=llm
WIDEGOLD_EXPLANATION_MODE=deterministic
WIDEGOLD_NEWS_MODE=akshare

# PostgreSQL / Redis
POSTGRES_USER=widegold
POSTGRES_PASSWORD=change-me
POSTGRES_DB=widegold
POSTGRES_PORT=5432
REDIS_PORT=6379
WIDEGOLD_DATABASE_URL=postgresql+psycopg://widegold:change-me@localhost:5432/widegold
WIDEGOLD_REDIS_URL=redis://localhost:6379/0

# Prefect
PREFECT_PORT=4200
PREFECT_API_URL=http://localhost:4200/api
WIDEGOLD_PREFECT_DEPLOYMENT_NAME=widegold-close-analysis/close-analysis
WIDEGOLD_PREFECT_RESEARCH_DEPLOYMENT_NAME=widegold-factor-research/factor-research
WIDEGOLD_PREFECT_REPLAY_DEPLOYMENT_NAME=widegold-replay-backfill/replay-backfill
WIDEGOLD_PREFECT_CALIBRATION_DEPLOYMENT_NAME=widegold-calibration-review/calibration-review

# LangGraph
WIDEGOLD_LANGGRAPH_CHECKPOINT_MODE=postgres
WIDEGOLD_LANGGRAPH_DATABASE_URL=postgresql://widegold:change-me@localhost:5432/langgraph
LANGGRAPH_STRICT_MSGPACK=true

# 管理员 / Session
WIDEGOLD_AUTH_MODE=session
WIDEGOLD_SESSION_TTL_SECONDS=28800
WIDEGOLD_COOKIE_SECURE=false
WIDEGOLD_BOOTSTRAP_ADMIN_USERNAME=admin
WIDEGOLD_BOOTSTRAP_ADMIN_PASSWORD=

# 运行控制
WIDEGOLD_RUN_LOCK_ENABLED=true
WIDEGOLD_RUN_LOCK_TTL_SECONDS=3600
WIDEGOLD_DASHBOARD_CACHE_ENABLED=true
WIDEGOLD_DASHBOARD_CACHE_TTL_SECONDS=300
WIDEGOLD_TRACE_FRONTEND_ENABLED=true
WIDEGOLD_TRACE_SSE_POLL_SECONDS=1.0
WIDEGOLD_TRACE_PAGE_SIZE=100

# LLM：低成本路由优先。
QWEN_API_KEY=
QWEN_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
WIDEGOLD_LLM_MAX_OUTPUT_TOKENS=1200

# 可选 L3 fallback；不用时留空。
GPT_COMPAT_API_KEY=
GPT_COMPAT_BASE_URL=https://api.openai.com/v1
GPT_COMPAT_MODEL=gpt-5.6-sol

# Final V1 默认关闭 Factor Research 搜索，避免额外付费调用。
SEARCH_PROVIDER=
SEARCH_API_KEY=
SEARCH_BASE_URL=
WIDEGOLD_RESEARCH_MODE=disabled

# Web
HTTP_PORT=8080

# Smoke；默认不触发真实 Analysis。
WIDEGOLD_SMOKE_TRIGGER_ANALYSIS=false
WIDEGOLD_SMOKE_MAX_POLL_SECONDS=600
